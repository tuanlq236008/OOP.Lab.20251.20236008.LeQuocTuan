{
    "version": "0.2.0",
    "configurations": [
        // Cấu hình mặc định: Chạy file Java hiện tại (thường không dùng cho JavaFX)
        {
            "type": "java",
            "name": "Current File (Default)",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Run Painter (JavaFX)",
            "request": "launch",
            "mainClass": "hust.soict.globalict.javafx.Painter",
            "vmArgs": "--module-path \"/Users/lequoctuan/Downloads/javafx-sdk-17.0.18/lib\" --add-modules javafx.controls,javafx.fxml,javafx.graphics",
        }
    ]
}